{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["user", "admin", "support", "manager", "bot_manager"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "GameServer": {
      "title": "GameServer",
      "description": "Available game server hosting plans.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "game": { "type": "string", "enum": ["FiveM", "Minecraft", "CS2", "Rust"] },
        "provider": { "type": "string" },
        "planName": { "type": "string" },
        "ram": { "type": "string" },
        "cpu": { "type": "string" },
        "storage": { "type": "string" },
        "priceMonthly": { "type": "number" },
        "currency": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["game", "provider", "planName", "priceMonthly"]
    },
    "Booking": {
      "title": "Booking",
      "description": "User's server subscription.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "serverId": { "type": "string" },
        "game": { "type": "string" },
        "planName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "expired"] },
        "paymentMethod": { "type": "string", "enum": ["Vodafone Cash", "Credit Card"] },
        "expiryDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "serverIp": { "type": "string" }
      },
      "required": ["userId", "serverId", "status", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Technical support or payment verification request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketNumber": { "type": "integer" },
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "screenshotUrl": { "type": "string", "format": "uri" },
        "status": { "type": "string", "enum": ["open", "closed", "pending_payment"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "botResponse": { "type": "string" }
      },
      "required": ["userId", "subject", "message", "status", "createdAt", "ticketNumber"]
    },
    "StaffApplication": {
      "title": "StaffApplication",
      "description": "Application to join the management team.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "experience": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "status", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Public announcement or notification.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning"] },
        "link": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "type", "createdAt"]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Global configuration for the platform.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "siteLogo": { "type": "string", "format": "uri" },
        "vodafoneNumber": { "type": "string" },
        "etisalatNumber": { "type": "string" },
        "discordUrl": { "type": "string", "format": "uri" },
        "facebookUrl": { "type": "string", "format": "uri" },
        "tiktokUrl": { "type": "string", "format": "uri" },
        "botMessages": { 
          "type": "object",
          "properties": {
            "paymentApproved": { "type": "string" },
            "welcomeMessage": { "type": "string" }
          }
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/servers/{serverId}": {
      "schema": "GameServer",
      "description": "Available game server plans."
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "User server bookings."
    },
    "/tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Support tickets."
    },
    "/applications/{appId}": {
      "schema": "StaffApplication",
      "description": "Staff applications."
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Public announcements."
    },
    "/config/global": {
      "schema": "AdminConfig",
      "description": "Global settings."
    }
  }
}
